# Environment Variables Example
# Copy this file to .env for local development
# NEVER commit .env file to version control

# Node Environment
NODE_ENV=development

# API Keys (if needed in future)
# IMPORTANT: Never expose API keys in client-side code
# Use a backend API proxy for sensitive operations
VITE_API_URL=https://your-backend-api.com

# Analytics (if implementing)
# VITE_ANALYTICS_ID=your-analytics-id

# Error Monitoring (if implementing Sentry)
# VITE_SENTRY_DSN=your-sentry-dsn
# VITE_SENTRY_ENVIRONMENT=development

# Feature Flags (optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_CONTACT_FORM=false

# Security Notes:
# 1. Only use VITE_ prefix for variables that MUST be exposed to client
# 2. Never store passwords, tokens, or secrets in .env
# 3. Use backend API for sensitive operations
# 4. Add .env to .gitignore (already configured)
# 5. Use different .env files for different environments
